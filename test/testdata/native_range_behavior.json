{
  "tests": [
    {"scheme": "pypi", "range": "~=1.4.dev1", "version": "1.4.dev1", "expected": true},
    {"scheme": "pypi", "range": "~=1.4.dev1", "version": "1.9", "expected": true},
    {"scheme": "pypi", "range": "~=1.4.dev1", "version": "2.0", "expected": false},
    {"scheme": "pypi", "range": "~=1.4.dev1", "version": "1.3", "expected": false},
    {"scheme": "pypi", "range": "~=1.4.5", "version": "1.4.6", "expected": true},
    {"scheme": "pypi", "range": "~=1.4.5", "version": "1.5", "expected": false},
    {"scheme": "pypi", "range": "~=1.4.5.post1", "version": "1.4.9", "expected": true},
    {"scheme": "pypi", "range": "~=1.4.5.post1", "version": "1.5", "expected": false},
    {"scheme": "pypi", "range": "~=2.0.dev1", "version": "2.5", "expected": true},
    {"scheme": "pypi", "range": "~=2.0.dev1", "version": "3.0", "expected": false},
    {"scheme": "pypi", "range": "~=2.0.0", "version": "2.0.9", "expected": true},
    {"scheme": "pypi", "range": "~=2.0.0", "version": "2.1", "expected": false},
    {"scheme": "pypi", "range": "~=1!1.4.5", "version": "1!1.4.6", "expected": true},
    {"scheme": "pypi", "range": "~=1!1.4.5", "version": "1!1.5", "expected": false},
    {"scheme": "pypi", "range": "~=1!1.4.5", "version": "1.4.6", "expected": false},
    {"scheme": "pypi", "range": "~=1.4.2,!=1.4.5", "version": "1.4.5", "expected": false},
    {"scheme": "pypi", "range": "~=1.4.2,!=1.4.5", "version": "1.4.6", "expected": true},
    {"scheme": "pypi", "range": "~=1.4.2,!=1.4.5", "version": "1.5", "expected": false},
    {"scheme": "pypi", "range": ">=1.0,~=1.4", "version": "2.0", "expected": false},
    {"scheme": "pypi", "range": ">=1.0,~=1.4", "version": "1.4", "expected": true},
    {"scheme": "pypi", "range": ">=1.0,~=1.4", "version": "1.9", "expected": true},
    {"scheme": "pypi", "range": "~=1.4, !=1.4.5, <1.4.8", "version": "1.4.6", "expected": true},
    {"scheme": "pypi", "range": "~=1.4, !=1.4.5, <1.4.8", "version": "1.4.5", "expected": false},
    {"scheme": "pypi", "range": "~=1.4, !=1.4.5, <1.4.8", "version": "1.4.9", "expected": false},
    {"scheme": "pypi", "range": "~=1.0.dev1,<1.0a1", "version": "1.0.dev2", "expected": true},
    {"scheme": "pypi", "range": "~=1.0.dev1,<1.0a1", "version": "1.0a1", "expected": false},
    {"scheme": "pypi", "range": "<1.0a1,~=1.0.dev1", "version": "1.0.dev2", "expected": true},
    {"scheme": "pypi", "range": "==1.4.*", "version": "1.4.9", "expected": true},
    {"scheme": "pypi", "range": "==1.4.*", "version": "1.5", "expected": false},
    {"scheme": "pypi", "range": "!=1.4.*", "version": "1.4.9", "expected": false},
    {"scheme": "pypi", "range": "!=1.4.*", "version": "1.5", "expected": true},
    {"scheme": "npm", "range": "^x", "version": "999.0.0", "expected": true},
    {"scheme": "npm", "range": "^0", "version": "0.9.0", "expected": true},
    {"scheme": "npm", "range": "^0", "version": "1.0.0", "expected": false},
    {"scheme": "npm", "range": "^0.0", "version": "0.0.9", "expected": true},
    {"scheme": "npm", "range": "^0.0", "version": "0.1.0", "expected": false},
    {"scheme": "npm", "range": "~x", "version": "999.0.0", "expected": true},
    {"scheme": "npm", "range": "~>1", "version": "1.9.0", "expected": true},
    {"scheme": "npm", "range": "~>1", "version": "2.0.0", "expected": false},
    {"scheme": "npm", "range": "2.x.x", "version": "2.9.0", "expected": true},
    {"scheme": "npm", "range": "2", "version": "2.9.0", "expected": true},
    {"scheme": "npm", "range": "2.3", "version": "2.3.9", "expected": true},
    {"scheme": "npm", "range": "<1.2", "version": "1.2.1", "expected": false},
    {"scheme": "npm", "range": "<=0.7.x", "version": "0.6.2", "expected": true},
    {"scheme": "npm", "range": "1 - 2", "version": "2.9.0", "expected": true},
    {"scheme": "npm", "range": "1 - 2", "version": "3.0.0", "expected": false},
    {"scheme": "npm", "range": "*", "version": "1.0.0-pre", "expected": false},
    {"scheme": "npm", "range": "^1.2.3", "version": "2.0.0-alpha", "expected": false},
    {"scheme": "npm", "range": "<\t2.0.0", "version": "0.2.9", "expected": true}
  ]
}
