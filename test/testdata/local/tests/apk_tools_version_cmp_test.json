{
  "tests": [
    {
      "description": "apk-tools orders a pre-release before its base version.",
      "test_group": "required",
      "test_type": "comparison",
      "input": {"input_type": "apk", "versions": ["6.0", "6.0_pre1"]},
      "expected_output": ["6.0_pre1", "6.0"]
    },
    {
      "description": "apk-tools orders a patch suffix after its base version.",
      "test_group": "required",
      "test_type": "comparison",
      "input": {"input_type": "apk", "versions": ["6.1_p1", "6.1"]},
      "expected_output": ["6.1", "6.1_p1"]
    },
    {
      "description": "apk-tools treats CVS and SVN suffixes as different.",
      "test_group": "required",
      "test_type": "equality",
      "input": {"input_type": "apk", "versions": ["1.0_cvs", "1.0_svn"]},
      "expected_output": false
    },
    {
      "description": "apk-tools compares later components with leading zeroes as strings.",
      "test_group": "required",
      "test_type": "comparison",
      "input": {"input_type": "apk", "versions": ["8.2.001", "8.2.0"]},
      "expected_output": ["8.2.0", "8.2.001"]
    },
    {
      "description": "apk-tools preserves string ordering when both components have leading zeroes.",
      "test_group": "required",
      "test_type": "comparison",
      "input": {"input_type": "apk", "versions": ["8.2.002", "8.2.0015"]},
      "expected_output": ["8.2.0015", "8.2.002"]
    },
    {
      "description": "apk-tools orders commit hashes lexically.",
      "test_group": "required",
      "test_type": "comparison",
      "input": {"input_type": "apk", "versions": ["1.0~2345", "1.0~1234"]},
      "expected_output": ["1.0~1234", "1.0~2345"]
    },
    {
      "description": "apk-tools compares revisions after commit hashes.",
      "test_group": "required",
      "test_type": "comparison",
      "input": {"input_type": "apk", "versions": ["1.0~1234-r1", "1.0~1234-r0"]},
      "expected_output": ["1.0~1234-r0", "1.0~1234-r1"]
    }
  ]
}
