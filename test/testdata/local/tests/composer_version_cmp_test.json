{
  "$schema": "https://packageurl.org/schemas/vers-test.schema-0.2.json",
  "tests": [
    {
      "description": "composer/semver orders \"1.24.0\" before \"1.25.0\".",
      "test_group": "recommended",
      "test_type": "comparison",
      "input": {
        "input_type": "composer",
        "versions": [
          "1.25.0",
          "1.24.0"
        ]
      },
      "expected_output": [
        "1.24.0",
        "1.25.0"
      ]
    },
    {
      "description": "composer/semver treats \"1.25.0\" and \"1.24.0\" as different.",
      "test_group": "recommended",
      "test_type": "equality",
      "input": {
        "input_type": "composer",
        "versions": [
          "1.25.0",
          "1.24.0"
        ]
      },
      "expected_output": false
    },
    {
      "description": "composer/semver orders \"1.25.0\" before \"1.26.0\".",
      "test_group": "recommended",
      "test_type": "comparison",
      "input": {
        "input_type": "composer",
        "versions": [
          "1.26.0",
          "1.25.0"
        ]
      },
      "expected_output": [
        "1.25.0",
        "1.26.0"
      ]
    },
    {
      "description": "composer/semver treats \"1.25.0\" and \"1.26.0\" as different.",
      "test_group": "recommended",
      "test_type": "equality",
      "input": {
        "input_type": "composer",
        "versions": [
          "1.25.0",
          "1.26.0"
        ]
      },
      "expected_output": false
    },
    {
