{
  "$schema": "https://packageurl.org/schemas/vers-test.schema-0.2.json",
  "tests": [
    {
      "description": "Composer converts an asterisk wildcard.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "*"
      },
      "expected_output": "vers:composer/*"
    },
    {
      "description": "Composer converts an x wildcard.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "x"
      },
      "expected_output": "vers:composer/*"
    },
    {
      "description": "Composer converts an exact version.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "1.2.3"
      },
      "expected_output": "vers:composer/1.2.3"
    },
    {
      "description": "Composer converts double equals.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "==1.2.3"
      },
      "expected_output": "vers:composer/1.2.3"
    },
    {
      "description": "Composer converts angle-bracket exclusion.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "<>1.2.3"
      },
      "expected_output": "vers:composer/!=1.2.3"
    },
    {
      "description": "Composer converts a space-separated intersection.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": ">=1.0 <2.0"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<2.0.0-dev"
    },
    {
      "description": "Composer converts a partial lower bound.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": ">=1.2"
      },
      "expected_output": "vers:composer/>=1.2.0-dev"
    },
    {
      "description": "Composer converts a partial upper bound.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "<2.0"
      },
      "expected_output": "vers:composer/<2.0.0-dev"
    },
    {
      "description": "Composer converts a comma-separated intersection.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": ">=1.0, <2.0"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<2.0.0-dev"
    },
    {
      "description": "Composer converts a double-pipe union.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^1.0 || ^2.0"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<2.0.0-dev|>=2.0.0-dev|<3.0.0-dev"
    },
    {
      "description": "Composer converts an aliased union branch.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "dev-main as 2.x-dev || ^2.0"
      },
      "expected_output": "vers:composer/dev-main|>=2.0.0-dev|<3.0.0-dev"
    },
    {
      "description": "Composer converts a single-pipe union.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^1.0 | ^2.0"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<2.0.0-dev|>=2.0.0-dev|<3.0.0-dev"
    },
    {
      "description": "Composer converts a disjoint union.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "<1.1 || >=1.2"
      },
      "expected_output": "vers:composer/<1.1.0-dev|>=1.2.0-dev"
    },
    {
      "description": "Composer converts a partial hyphen range.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "1.0 - 2.0"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<2.1.0-dev"
    },
    {
      "description": "Composer converts a full hyphen range.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "1.0.0 - 2.1.0"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<=2.1.0"
    },
    {
      "description": "Composer converts a minor wildcard.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "1.2.*"
      },
      "expected_output": "vers:composer/>=1.2.0-dev|<1.3.0-dev"
    },
    {
      "description": "Composer converts a repeated wildcard.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "2.*.*"
      },
      "expected_output": "vers:composer/>=2.0.0-dev|<3.0.0-dev"
    },
    {
      "description": "Composer converts a partial tilde range.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "~1.2"
      },
      "expected_output": "vers:composer/>=1.2.0-dev|<2.0.0-dev"
    },
    {
      "description": "Composer converts a full tilde range.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "~1.2.3"
      },
      "expected_output": "vers:composer/>=1.2.3-dev|<1.3.0-dev"
    },
    {
      "description": "Composer converts shorthand stability.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^1.2.3beta1"
      },
      "expected_output": "vers:composer/>=1.2.3-beta1|<2.0.0-dev"
    },
    {
      "description": "Composer converts dotted stability.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "~1.2.3.RC1"
      },
      "expected_output": "vers:composer/>=1.2.3-RC1|<1.3.0-dev"
    },
    {
      "description": "Composer converts a zero-major caret.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^0.3"
      },
      "expected_output": "vers:composer/>=0.3.0-dev|<0.4.0-dev"
    },
    {
      "description": "Composer converts a partial caret.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^1.2"
      },
      "expected_output": "vers:composer/>=1.2.0-dev|<2.0.0-dev"
    },
    {
      "description": "Composer converts a four-component caret.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^0.0.0.3"
      },
      "expected_output": "vers:composer/>=0.0.0.3-dev|<0.0.1.0-dev"
    },
    {
      "description": "Composer converts an exclusion in an intersection.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": ">=1.0 !=1.5"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|!=1.5.0"
    },
    {
      "description": "Composer converts a caret stability flag.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "^1.2@beta"
      },
      "expected_output": "vers:composer/>=1.2.0-dev|<2.0.0-dev"
    },
    {
      "description": "Composer converts a comparator stability flag.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": ">=1.0@beta"
      },
      "expected_output": "vers:composer/>=1.0.0-beta"
    },
    {
      "description": "Composer converts a standalone stability flag.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "@dev"
      },
      "expected_output": "vers:composer/*"
    },
    {
      "description": "Composer converts a prerelease hyphen bound.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "1.0 - 2.1-beta"
      },
      "expected_output": "vers:composer/>=1.0.0-dev|<=2.1.0-beta"
    },
    {
      "description": "Composer converts a branch alias.",
      "test_group": "recommended",
      "test_type": "from_native",
      "input": {
        "type": "composer",
        "native_range": "dev-main as 1.0.x-dev"
      },
      "expected_output": "vers:composer/dev-main"
    }
  ]
}
