{
  "$schema": "https://packageurl.org/schemas/vers-test.schema-0.2.json",
  "tests": [
    {
      "description": "RubyGems treats \"1.0\" and \"1.0.0\" as equal.",
      "test_group": "recommended",
      "test_type": "equality",
      "input": {
        "input_type": "gem",
        "versions": [
          "1.0",
          "1.0.0"
        ]
      },
      "expected_output": true
    },
    {
      "description": "RubyGems orders \"1.0.a\" before \"1.0\".",
      "test_group": "recommended",
      "test_type": "comparison",
      "input": {
        "input_type": "gem",
        "versions": [
          "1.0",
          "1.0.a"
        ]
      },
      "expected_output": [
        "1.0.a",
        "1.0"
      ]
    },
    {
      "description": "RubyGems treats \"1.0\" and \"1.0.a\" as different.",
      "test_group": "recommended",
      "test_type": "equality",
      "input": {
        "input_type": "gem",
        "versions": [
          "1.0",
          "1.0.a"
        ]
      },
      "expected_output": false
    },
    {
      "description": "RubyGems orders \"0.0.0\" before \"1.8.2\".",
      "test_group": "recommended",
      "test_type": "comparison",
      "input": {
        "input_type": "gem",
        "versions": [
          "1.8.2",
          "0.0.0"
        ]
      },
      "expected_output": [
        "0.0.0",
        "1.8.2"
      ]
    },
    {
      "description": "RubyGems treats \"1.8.2\" and \"0.0.0\" as different.",
      "test_group": "recommended",
      "test_type": "equality",
      "input": {
        "input_type": "gem",
        "versions": [
          "1.8.2",
          "0.0.0"
        ]
      },
      "expected_output": false
    },
    {
