      "test_group": "recommended",
      "test_type": "comparison",
      "input": {
        "input_type": "pub",
        "versions": [
          "1.0.0-alpha.1",
          "1.0.0-alpha"
        ]
      },
      "expected_output": [
        "1.0.0-alpha",
        "1.0.0-alpha.1"
      ]
    },
