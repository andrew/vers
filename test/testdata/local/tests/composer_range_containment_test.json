{
  "$schema": "https://packageurl.org/schemas/vers-test.schema-0.2.json",
  "tests": [
    {
      "description": "Composer wildcard contains a release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/*",
        "version": "99.0.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer exact range contains the same version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/1.2.3",
        "version": "1.2.3"
      },
      "expected_output": true
    },
    {
      "description": "Composer exact range excludes another version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/1.2.3",
        "version": "1.2.4"
      },
      "expected_output": false
    },
    {
      "description": "Composer exclusion removes the exact version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/!=1.2.3",
        "version": "1.2.3"
      },
      "expected_output": false
    },
    {
      "description": "Composer intersection contains an interior version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<2.0.0-dev",
        "version": "1.5.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer intersection excludes its upper bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<2.0.0-dev",
        "version": "2.0.0"
      },
      "expected_output": false
    },
    {
      "description": "Composer partial lower bound contains its dev release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev",
        "version": "1.2.0-dev"
      },
      "expected_output": true
    },
    {
      "description": "Composer partial upper bound excludes an earlier prerelease of that bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/<2.0.0-dev",
        "version": "2.0.0-beta"
      },
      "expected_output": false
    },
    {
      "description": "Composer caret union contains its second branch.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<2.0.0-dev|>=2.0.0-dev|<3.0.0-dev",
        "version": "2.5.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer aliased union keeps its range branch.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=2.0.0-dev|<3.0.0-dev|dev-main",
        "version": "2.5.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer disjoint union excludes its gap.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/<1.1.0-dev|>=1.2.0-dev",
        "version": "1.1.5"
      },
      "expected_output": false
    },
    {
      "description": "Composer partial hyphen range contains its completed upper version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<2.1.0-dev",
        "version": "2.0.9"
      },
      "expected_output": true
    },
    {
      "description": "Composer partial hyphen range excludes the next minor.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<2.1.0-dev",
        "version": "2.1.0"
      },
      "expected_output": false
    },
    {
      "description": "Composer full hyphen range contains its upper bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<=2.1.0",
        "version": "2.1.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer minor wildcard contains a patch release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<1.3.0-dev",
        "version": "1.2.9"
      },
      "expected_output": true
    },
    {
      "description": "Composer minor wildcard contains its lower dev release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<1.3.0-dev",
        "version": "1.2.0-dev"
      },
      "expected_output": true
    },
    {
      "description": "Composer minor wildcard excludes the next minor.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<1.3.0-dev",
        "version": "1.3.0"
      },
      "expected_output": false
    },
    {
      "description": "Composer repeated wildcard contains a matching release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=2.0.0-dev|<3.0.0-dev",
        "version": "2.9.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer partial tilde range contains a later minor.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<2.0.0-dev",
        "version": "1.9.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer partial tilde range contains its lower dev release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<2.0.0-dev",
        "version": "1.2.0-dev"
      },
      "expected_output": true
    },
    {
      "description": "Composer partial tilde range excludes the next major prerelease.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<2.0.0-dev",
        "version": "2.0.0-beta.1"
      },
      "expected_output": false
    },
    {
      "description": "Composer full tilde range excludes the next minor.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.3-dev|<1.3.0-dev",
        "version": "1.3.0"
      },
      "expected_output": false
    },
    {
      "description": "Composer shorthand stability range contains a later beta.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.3-beta1|<2.0.0-dev",
        "version": "1.2.3-beta2"
      },
      "expected_output": true
    },
    {
      "description": "Composer dotted stability range contains a later release candidate.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.3-RC1|<1.3.0-dev",
        "version": "1.2.3-RC2"
      },
      "expected_output": true
    },
    {
      "description": "Composer zero-major caret contains a patch release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=0.3.0-dev|<0.4.0-dev",
        "version": "0.3.9"
      },
      "expected_output": true
    },
    {
      "description": "Composer zero-major caret excludes the next minor.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=0.3.0-dev|<0.4.0-dev",
        "version": "0.4.0"
      },
      "expected_output": false
    },
    {
      "description": "Composer four-component caret contains a matching release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=0.0.0.3-dev|<0.0.1.0-dev",
        "version": "0.0.0.9"
      },
      "expected_output": true
    },
    {
      "description": "Composer four-component caret excludes the next patch.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=0.0.0.3-dev|<0.0.1.0-dev",
        "version": "0.0.1.0-dev"
      },
      "expected_output": false
    },
    {
      "description": "Composer intersection exclusion removes a normalized version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|!=1.5.0",
        "version": "1.5.0"
      },
      "expected_output": false
    },
    {
      "description": "Composer caret stability range contains a stable release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.2.0-dev|<2.0.0-dev",
        "version": "1.5.0"
      },
      "expected_output": true
    },
    {
      "description": "Composer beta lower bound excludes an alpha.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-beta",
        "version": "1.0.0-alpha"
      },
      "expected_output": false
    },
    {
      "description": "Composer beta lower bound contains the same stability.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-beta",
        "version": "1.0.0-beta"
      },
      "expected_output": true
    },
    {
      "description": "Composer standalone stability wildcard contains a dev release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/*",
        "version": "1.0.0-dev"
      },
      "expected_output": true
    },
    {
      "description": "Composer hyphen range contains its lower dev release.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<2.1.0-dev",
        "version": "1.0.0-dev"
      },
      "expected_output": true
    },
    {
      "description": "Composer hyphen range contains its prerelease upper bound.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/>=1.0.0-dev|<=2.1.0-beta",
        "version": "2.1.0-beta"
      },
      "expected_output": true
    },
    {
      "description": "Composer branch alias contains the branch version.",
      "test_group": "recommended",
      "test_type": "containment",
      "input": {
        "vers": "vers:composer/dev-main",
        "version": "dev-main"
      },
      "expected_output": true
    }
  ]
}
